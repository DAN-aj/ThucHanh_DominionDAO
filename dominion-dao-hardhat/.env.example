# Đổi tên file này thành .env rồi điền giá trị.
# Private key lấy trong MetaMask: Account details -> Show private key.
# CHỈ dùng ví test (chỉ có SepoliaETH), không dùng ví có tiền thật.
PRIVATE_KEY=

# RPC Sepolia công khai (có thể thay bằng Infura/Alchemy nếu bị lỗi kết nối)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
